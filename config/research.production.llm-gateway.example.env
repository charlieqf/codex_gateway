NODE_ENV=production
GATEWAY_AUTH_MODE=credential
GATEWAY_REQUIRE_ENTITLEMENT=1
GATEWAY_ALLOW_EMPTY_UPSTREAM_POOL=0
GATEWAY_API_KEY_ENCRYPTION_SECRET=replace-with-production-research-llm-random-secret
GATEWAY_LOG_LEVEL=info

# This is a fail-safe for callers that omit the per-call timeout header. The
# Research Worker sends a shorter deadline derived from each shard budget so
# the Gateway can return a structured timeout and release reservations before
# the Worker's call deadline.
MEDCODE_CHAT_REQUEST_TIMEOUT_MS=175000

# Research generation uses one reviewed direct GoldenCode route: Tencent
# GLM-5.3 at concurrency 3. Qianfan and Aliyun are not configured as adapters,
# pool members, or fallback routes.
MEDCODE_PUBLIC_MODEL_ID=goldencode
MEDCODE_PUBLIC_MODELS_JSON_FILE=/etc/codex-gateway/research-production-goldencode.json
MEDCODE_TENCENT_TOKENHUB_API_KEY_FILE=/run/secrets/research_production_tencent_api_key
MEDCODE_TENCENT_TOKENHUB_TIMEOUT_MS=900000
