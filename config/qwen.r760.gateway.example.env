# Merge these values into the existing authoritative R760 Gateway env. Keep its
# current SQLite, encryption secret, auth, phone-login, and goldencode settings.
MEDCODE_LOCAL_OPENAI_BASE_URL=http://qwen38-fp8:8000/v1
MEDCODE_LOCAL_OPENAI_TIMEOUT_MS=900000
# Roll out exact vLLM /tokenize admission as disabled -> shadow -> enforce.
# Tokenizer failures always fail open; upstream context validation remains a fallback.
MEDCODE_LOCAL_CONTEXT_ADMISSION_MODE=disabled
# The production Gateway enables an outbound HTTP proxy. These private Docker
# names must bypass it or Node fetch sends Qwen traffic to the proxy.
NO_PROXY=qwen38-fp8,qwen38-fp8-local
no_proxy=qwen38-fp8,qwen38-fp8-local
MEDCODE_NATIVE_FILE_TOOL_RECOVERY_MODE=error
