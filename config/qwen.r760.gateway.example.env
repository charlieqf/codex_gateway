NODE_ENV=production
GATEWAY_AUTH_MODE=credential
GATEWAY_SQLITE_PATH=/var/lib/codex-gateway/gateway.db
GATEWAY_API_KEY_ENCRYPTION_SECRET=replace-with-qwen-only-random-secret
GATEWAY_REQUIRE_ENTITLEMENT=0
GATEWAY_PUBLIC_BASE_URL=https://qwen-api.instmarket.com.au:1443
GATEWAY_PUBLIC_PROVIDER_NAME=qwen-local
GATEWAY_PUBLIC_PROVIDER_DISPLAY_NAME=Qwen Internal
GATEWAY_PUBLIC_SERVICE_NAME=qwen-api
GATEWAY_PUBLIC_PHASE=internal-pilot
GATEWAY_PHONE_AUTH_MODE=disabled
GATEWAY_DESKTOP_VERSION_GATE=disabled
MEDCODE_PUBLIC_MODEL_ID=qwen3.8-27b-fp8
MEDCODE_PUBLIC_MODELS_JSON_FILE=/run/qwen/public-models.json
MEDCODE_LOCAL_OPENAI_BASE_URL=http://qwen38-fp8:8000/v1
MEDCODE_LOCAL_OPENAI_TIMEOUT_MS=900000
MEDCODE_NATIVE_FILE_TOOL_RECOVERY_MODE=error
CODEX_HOME=/var/lib/codex-gateway/codex-home
CODEX_WORKDIR=/app
CODEX_SKIP_GIT_REPO_CHECK=1
