{
  "schema_version": 1,
  "analysis_profile": "alphafold3-monomer-public-msa-v1",
  "available": true,
  "research_only": true,
  "retention_seconds": 86400,
  "artifact_names": [
    "result.json",
    "report.csv",
    "preview.png",
    "structure.cif",
    "scores.json",
    "structure.html",
    "models.zip"
  ],
