    "relaxation": false,
    "num_models": 1,
    "num_diffusion_samples": 5,
    "num_recycle": 10,
    "random_seed": 0,
    "structure_format": "mmcif",
    "confidence_unit": "atom",
    "supports_complexes": false,
    "supports_ligands": false,
    "supports_nucleic_acids": false,
    "max_sequence_bytes": 4096
