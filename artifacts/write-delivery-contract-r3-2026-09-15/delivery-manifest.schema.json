{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "request_nonce",
    "client_session_id",
    "client_turn_id",
    "delivery_id",
    "tool_call_id",
    "tool_name",
    "arguments_sha256"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "client_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "client_turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool_call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool_name": {
      "const": "write_delivery_v1"
    },
    "arguments_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

