[Unit]
Description=Private authenticated Qwen-Image-2.1 on GPU 1
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/apps/qwen-image-21-eval/current/scripts/experiments/qwen-image-21-eval
Environment=CUDA_VISIBLE_DEVICES=1
Environment=HF_HOME=/data/apps/qwen-image-21-eval/cache/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TRITON_CACHE_DIR=/data/apps/qwen-image-21-eval/cache/triton
Environment=TORCHINDUCTOR_CACHE_DIR=/data/apps/qwen-image-21-eval/cache/inductor
Environment=PYTORCH_KERNEL_CACHE_PATH=/data/apps/qwen-image-21-eval/cache/torch
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=OMP_NUM_THREADS=8
EnvironmentFile=/data/apps/qwen-image-21-eval/api.env
ExecStart=/data/apps/qwen-image-21-eval/env/bin/python -m uvicorn qwen_eval_api:app --host 127.0.0.1 --port 8191 --workers 1 --no-access-log
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/apps/qwen-image-21-eval/state /data/apps/qwen-image-21-eval/cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64G
CPUQuota=800%

[Install]
WantedBy=default.target
